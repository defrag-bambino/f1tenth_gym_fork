# =============================================================================
# Dockerfile for F1TENTH DreamerV3 Training & Inference on Real Car
# =============================================================================
#
# Build from repository root:
#   docker build -t f1tenth-dreamer:latest -f Dockerfile.realcar .
#
# =============================================================================
# IMPORTANT: ROS2 NETWORK CONFIGURATION
# =============================================================================
#
# This container MUST be run with host networking to communicate with ROS2:
#
#   docker run --rm -it \
#       --net=host \
#       --ipc=host \
#       --gpus all \
#       -v /path/to/checkpoints:/checkpoints \
#       -v /path/to/logs:/logdir \
#       f1tenth-dreamer:latest \
#       python3 /f1tenth_gym/train_dreamerv3.py --real --from_checkpoint /checkpoints/sim_ckpt
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  WARNING: The F1TENTH car must have ROS_LOCALHOST_ONLY=0 set!           │
# │           Otherwise, the container cannot communicate with ROS2 nodes.  │
# │                                                                         │
# │  On the car, run: export ROS_LOCALHOST_ONLY=0                           │
# │  Or add to ~/.bashrc: export ROS_LOCALHOST_ONLY=0                       │
# └─────────────────────────────────────────────────────────────────────────┘
#
# =============================================================================

# Use ROS2 Humble with CUDA support for JAX training
ARG BASE_IMAGE=ros:humble-ros-base
FROM ${BASE_IMAGE}

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=humble
ENV PYTHONUNBUFFERED=1

# =============================================================================
# System Dependencies
# =============================================================================
RUN apt-get update && apt-get install -y \
    python3-pip \
    python3-colcon-common-extensions \
    ros-humble-ackermann-msgs \
    ros-humble-sensor-msgs \
    ros-humble-nav-msgs \
    ros-humble-geometry-msgs \
    wget \
    git \
    curl \
    vim \
    && rm -rf /var/lib/apt/lists/*

# =============================================================================
# Python Dependencies for Training
# =============================================================================

# Upgrade pip
RUN pip3 install --upgrade pip

# Install JAX with CUDA support (for GPU training)
# Tries CUDA 12 first, then CUDA 11, then CPU-only
RUN pip3 install --upgrade "jax[cuda12_pip]" -f https://storage.googleapis.com/jax-releases/jax_cuda_releases.html || \
    pip3 install --upgrade "jax[cuda11_pip]" -f https://storage.googleapis.com/jax-releases/jax_cuda_releases.html || \
    pip3 install --upgrade jax jaxlib

# Install DreamerV3 dependencies
RUN pip3 install \
    numpy \
    transforms3d==0.4.1 \
    gymnasium \
    ruamel.yaml \
    tensorboard \
    matplotlib \
    pandas \
    tensorflow-cpu

# Clone and install DreamerV3 from source (includes embodied and elements)
# This avoids PyPI package issues
# Keep the source directory for editable install to work
RUN git clone https://github.com/danijar/dreamerv3.git /opt/dreamerv3 && \
    cd /opt/dreamerv3 && \
    pip3 install -e .

# Install ONNX runtime for inference mode
RUN pip3 install onnxruntime==1.16.3

# =============================================================================
# Create ROS2 Workspace
# =============================================================================
RUN mkdir -p /ros2_ws/src
WORKDIR /ros2_ws

# Copy the ROS2 packages
COPY realcar/f1tenth_onnx_inference /ros2_ws/src/f1tenth_onnx_inference
COPY realcar/f1tenth_dreamer_training /ros2_ws/src/f1tenth_dreamer_training

# Build the ROS2 workspace
RUN /bin/bash -c "source /opt/ros/humble/setup.bash && \
    cd /ros2_ws && \
    colcon build --symlink-install"

# =============================================================================
# Copy F1TENTH Gym and Training Scripts
# =============================================================================

# Create directory and copy f1tenth gym package
RUN mkdir -p /f1tenth_gym
COPY f1tenth_gym /f1tenth_gym/f1tenth_gym

# Copy training scripts and environment wrappers
COPY f1tenth.py /f1tenth_gym/f1tenth.py
COPY f1tenth_real.py /f1tenth_gym/f1tenth_real.py
COPY train_dreamerv3.py /f1tenth_gym/train_dreamerv3.py
COPY finetune_dreamerv3_real.py /f1tenth_gym/finetune_dreamerv3_real.py
COPY evaluate_dreamerv3.py /f1tenth_gym/evaluate_dreamerv3.py
COPY test_ros2_connection.py /f1tenth_gym/test_ros2_connection.py

# Install f1tenth_gym as editable package (if setup.py exists)
WORKDIR /f1tenth_gym
RUN pip3 install -e . 2>/dev/null || echo "No setup.py found, using PYTHONPATH instead"

# =============================================================================
# Setup Environment
# =============================================================================
WORKDIR /f1tenth_gym

# Source ROS2 and workspace in bashrc
RUN echo "source /opt/ros/humble/setup.bash" >> ~/.bashrc && \
    echo "source /ros2_ws/install/setup.bash" >> ~/.bashrc && \
    echo "export PYTHONPATH=/f1tenth_gym:\$PYTHONPATH" >> ~/.bashrc && \
    echo "cd /f1tenth_gym" >> ~/.bashrc

# Create entrypoint script
RUN echo '#!/bin/bash\n\
set -e\n\
\n\
# Source ROS2 setup\n\
source /opt/ros/humble/setup.bash\n\
source /ros2_ws/install/setup.bash\n\
export PYTHONPATH=/f1tenth_gym:$PYTHONPATH\n\
\n\
echo ""\n\
echo "============================================================"\n\
echo "  F1TENTH DreamerV3 Training Container"\n\
echo "============================================================"\n\
echo ""\n\
echo "  IMPORTANT: This container requires host networking!"\n\
echo ""\n\
echo "  If ROS2 topics are not visible, ensure:"\n\
echo "    1. Container started with: --net=host --ipc=host"\n\
echo "    2. Car has: export ROS_LOCALHOST_ONLY=0"\n\
echo ""\n\
echo "============================================================"\n\
echo ""\n\
\n\
# Check ROS2 connectivity\n\
if command -v ros2 &> /dev/null; then\n\
    echo "Checking ROS2 connectivity..."\n\
    timeout 3 ros2 topic list > /dev/null 2>&1 && echo "ROS2 topics accessible!" || echo "Warning: Cannot list ROS2 topics. Check network configuration."\n\
    echo ""\n\
fi\n\
\n\
exec "$@"\n\
' > /entrypoint.sh && chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]

# Default command shows usage
CMD ["bash", "-c", "echo '' && echo 'Usage Examples:' && echo '' && echo '  Test ROS2 connection:' && echo '    python3 test_ros2_connection.py' && echo '' && echo '  Training on real car:' && echo '    python3 train_dreamerv3.py --real --max_speed 3.0 --from_checkpoint /checkpoints/ckpt' && echo '' && echo '  Fine-tuning on real car (OOD detection):' && echo '    python3 finetune_dreamerv3_real.py --checkpoint /checkpoints/ckpt --max_speed 3.0' && echo '' && echo '  Evaluation on real car:' && echo '    python3 evaluate_dreamerv3.py /checkpoints/ckpt --real --max_speed 3.0 --episodes 5' && echo '' && echo '  Inference:' && echo '    ros2 launch f1tenth_onnx_inference inference.launch.py model_path:=/models/model.onnx' && echo '' && echo '  Interactive:' && echo '    bash' && echo ''"]
